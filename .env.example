# Docker Registry & Repository
DOCKER_REGISTRY=docker.io
DOCKER_REPO=your-docker-hub-username

# Application Environment
VITE_API_BASE_URL=/api
JWT_SECRET=your-secure-jwt-secret

# Database Configuration
POSTGRES_DB=meeting_scheduler
POSTGRES_USER=scheduler_user
POSTGRES_PASSWORD=scheduler_password

# Database Connection (for backend)
DB_URL=jdbc:postgresql://postgres:5432/meeting_scheduler
DB_USERNAME=scheduler_user
DB_PASSWORD=scheduler_password
